{
  "name": "xlb-platform-local",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm --filter @xlb/api dev\" \"pnpm --filter @xlb/web dev\"",
    "build": "pnpm --filter @xlb/api build && pnpm --filter @xlb/web build",
    "test": "pnpm --filter @xlb/api test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
