{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "XLB isolated temporary EC2 test host. No VPN keys, production data or public ingress. Delete this stack after testing.",
  "Parameters": {
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "SubnetId": {"Type": "AWS::EC2::Subnet::Id", "Description": "Public subnet with an internet gateway in this VPC"},
    "ImageId": {"Type": "AWS::EC2::Image::Id", "Description": "Reviewed Amazon Linux 2023 x86_64 AMI, pinned per region"},
    "InstanceType": {"Type": "String", "Default": "t3.micro", "AllowedValues": ["t3.micro", "t3.small"]},
    "InstanceProfile": {"Type": "String", "Description": "Existing dedicated XLB SSM instance profile; not a production role"},
    "ExpiryRoleArn": {"Type": "String", "AllowedPattern": "arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+", "Description": "Existing scheduler role allowing ec2:TerminateInstances only for tagged XLB test instances"},
    "ExpiresAtUtc": {"Type": "String", "AllowedPattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}", "Description": "UTC time within 15 to 60 minutes from now, without Z; generated immediately before deployment"},
    "LifetimeMinutes": {"Type": "Number", "Default": 30, "AllowedValues": [15, 30, 60]},
    "NodeId": {"Type": "String", "AllowedPattern": "xlb-lab-[a-z0-9-]{1,30}"}
  },
  "Resources": {
    "NodeSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Temporary XLB test node: no public inbound, SSM over outbound HTTPS",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}],
        "Tags": [{"Key": "Project", "Value": "xlb"}, {"Key": "Environment", "Value": "test"}, {"Key": "ManagedBy", "Value": "xlb-node-lab"}]
      }
    },
    "Node": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {"Ref": "ImageId"},
        "InstanceType": {"Ref": "InstanceType"},
        "IamInstanceProfile": {"Ref": "InstanceProfile"},
        "MetadataOptions": {"HttpTokens": "required", "HttpEndpoint": "enabled", "HttpPutResponseHopLimit": 1},
        "CreditSpecification": {"CPUCredits": "standard"},
        "InstanceInitiatedShutdownBehavior": "terminate",
        "PropagateTagsToVolumeOnCreation": true,
        "NetworkInterfaces": [{"DeviceIndex": "0", "AssociatePublicIpAddress": true, "SubnetId": {"Ref": "SubnetId"}, "GroupSet": [{"Ref": "NodeSecurityGroup"}]}],
        "BlockDeviceMappings": [{"DeviceName": "/dev/xvda", "Ebs": {"VolumeType": "gp3", "VolumeSize": 12, "Encrypted": true, "DeleteOnTermination": true}}],
        "UserData": {"Fn::Base64": {"Fn::Sub": "#!/bin/bash\nset -euo pipefail\nsystemd-run --unit=xlb-node-expiry --on-active=${LifetimeMinutes}m /usr/sbin/shutdown -h now\n"}},
        "Tags": [{"Key": "Name", "Value": {"Ref": "NodeId"}}, {"Key": "NodeId", "Value": {"Ref": "NodeId"}}, {"Key": "Project", "Value": "xlb"}, {"Key": "Environment", "Value": "test"}, {"Key": "ManagedBy", "Value": "xlb-node-lab"}, {"Key": "ExpiresAt", "Value": {"Ref": "ExpiresAtUtc"}}]
      }
    },
    "ExpirySchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": {"Fn::Sub": "${NodeId}-expiry"},
        "ScheduleExpression": {"Fn::Sub": "at(${ExpiresAtUtc})"},
        "ScheduleExpressionTimezone": "UTC",
        "FlexibleTimeWindow": {"Mode": "OFF"},
        "State": "ENABLED",
        "Target": {
          "Arn": "arn:aws:scheduler:::aws-sdk:ec2:terminateInstances",
          "RoleArn": {"Ref": "ExpiryRoleArn"},
          "Input": {"Fn::Sub": "{\"InstanceIds\":[\"${Node}\"]}"},
          "RetryPolicy": {"MaximumEventAgeInSeconds": 300, "MaximumRetryAttempts": 2}
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {"Value": {"Ref": "Node"}},
    "PublicIp": {"Value": {"Fn::GetAtt": ["Node", "PublicIp"]}},
    "SecurityGroupId": {"Value": {"Ref": "NodeSecurityGroup"}},
    "ExpiresAtUtc": {"Value": {"Ref": "ExpiresAtUtc"}}
  }
}
